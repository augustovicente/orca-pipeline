{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "id": "pipeline",
  "name": "Pipeline",
  "version": "0.11.3",
  "description": "Staged workflows for your agents: plan, build, test and review chained in one agent session.",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "pipeline",
        "title": "Pipeline",
        "icon": "layers",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      }
    ],
    "statusBarItems": [
      {
        "id": "run",
        "text": "Pipeline",
        "icon": "layers",
        "tooltip": "Pipeline run state"
      }
    ],
    "settings": [
      {
        "key": "stageTimeoutMinutes",
        "title": "Stage timeout (minutes)",
        "description": "How long one stage may run without a completion signal before it is marked failed.",
        "type": "integer",
        "default": 20,
        "minimum": 1,
        "maximum": 240
      },
      {
        "key": "notify",
        "title": "Desktop notifications",
        "description": "Show a notification when a run finishes, fails or needs you.",
        "type": "boolean",
        "default": true
      },
      {
        "key": "defaultAgent",
        "title": "Default agent",
        "description": "Agent for new pipelines and the seeded ones. Leave empty to use the agent running in your focused workspace, then claude.",
        "type": "string"
      },
      {
        "key": "highAgent",
        "title": "High reasoning — agent",
        "description": "Agent used by stages that ask for high reasoning, unless the pipeline or the stage names one.",
        "type": "string",
        "default": "opencode"
      },
      {
        "key": "highModel",
        "title": "High reasoning — model",
        "type": "string",
        "default": "opencode-go/deepseek-v4.1-flash"
      },
      {
        "key": "mediumAgent",
        "title": "Medium reasoning — agent",
        "type": "string",
        "default": "opencode"
      },
      {
        "key": "mediumModel",
        "title": "Medium reasoning — model",
        "type": "string",
        "default": "opencode/mimo-v2.6-flash-free"
      },
      {
        "key": "lowAgent",
        "title": "Low reasoning — agent",
        "type": "string",
        "default": "opencode"
      },
      {
        "key": "lowModel",
        "title": "Low reasoning — model",
        "type": "string",
        "default": "opencode-go/beam-free"
      },
      {
        "key": "modelBootSeconds",
        "title": "Model boot wait (seconds)",
        "description": "How long a stage that names a model waits for its agent to come up before the prompt is typed. Raise it if a slow CLI swallows the prompt.",
        "type": "integer",
        "default": 8,
        "minimum": 0,
        "maximum": 60
      },
      {
        "key": "maxParallelRuns",
        "title": "Runs at a time",
        "description": "How many pipelines may run at once; each one launches its own agent. 1 makes runs strictly sequential.",
        "type": "integer",
        "default": 5,
        "minimum": 1,
        "maximum": 8
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "agent:read"
    },
    {
      "kind": "agent:launch"
    },
    {
      "kind": "terminal:send"
    },
    {
      "kind": "terminal:read"
    },
    {
      "kind": "notifications:show"
    },
    {
      "kind": "storage:own"
    },
    {
      "kind": "settings:own"
    }
  ]
}
